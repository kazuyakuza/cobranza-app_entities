{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentAttempt",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "companyId": { "type": "string", "format": "uuid" },
    "clientId": { "type": "string", "format": "uuid" },
    "paymentProofId": { "type": "string", "format": "uuid" },
    "debtId": { "type": "string", "format": "uuid" },
    "amount": { "type": "string" },
    "currency": { "type": "string", "enum": ["ARS", "USD"] },
    "status": { "type": "string", "enum": ["UPLOADED", "PARSE_FAILED", "PENDING_VALIDATION", "MATCHED", "APPROVED", "REJECTED"] },
    "rejectionReason": { "type": "string" },
    "reviewedBy": { "type": "string", "format": "uuid" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "format": "uuid" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string", "format": "uuid" },
    "deletedAt": { "type": "string", "format": "date-time" },
    "deletedBy": { "type": "string", "format": "uuid" }
  },
  "required": [
    "id",
    "companyId",
    "clientId",
    "paymentProofId",
    "debtId",
    "status",
    "createdAt",
    "createdBy"
  ]
}